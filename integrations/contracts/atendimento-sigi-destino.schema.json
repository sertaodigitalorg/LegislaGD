  "title": "Atendimento SIGI-SD para sistemas destino",
  "type": "object",
  "required": ["id", "canal", "classificacao", "protocolo"],
  "properties": {
    "id": { "type": "string" },
    "canal": { "type": "string" },
    "classificacao": { "type": "string" },
    "protocolo": { "type": "string" },
    "destino": { "enum": ["SAPL-SD", "e-Cidade-SD"] }
  }
}
