LEGISLAGD_ENV=development
LEGISLAGD_DOMAIN=legislagd.localhost

# Branch padrao usada para clonar os forks dos componentes quando eles ainda
# nao existem no workspace. Valores usuais:
# - dev: desenvolvimento local
# - hml: homologacao
# - main: base principal/producao
LEGISLAGD_COMPONENT_BRANCH=dev
LEGISLAGD_GIT_STATUS_TIMEOUT=60
COMPOSE_HTTP_TIMEOUT=300
DOCKER_CLIENT_TIMEOUT=300

# Diretorio, relativo a raiz do LegislaGD, onde os componentes integrados sao
# clonados. Em producao, isso mantem a plataforma autocontida em um unico
# workspace, por exemplo /opt/legislagd/modules/SAPL-SD.
LEGISLAGD_COMPONENTS_DIR=modules

# Modulos da subida principal. Por padrao, make up sobe PortalModelo-SD,
# SAPL-SD e SIGI-SD. Altere para 0 quando quiser desabilitar algum modulo
# da subida padrao sem remover os comandos individuais.
LEGISLAGD_ENABLE_PORTAL=1
LEGISLAGD_ENABLE_SAPL=1
LEGISLAGD_ENABLE_SIGI=1
LEGISLAGD_ENABLE_KEYCLOAK=1
LEGISLAGD_ENABLE_PLENARIO=1

# e-Cidade-SD usa o Postgres central do LegislaGD nesta etapa.
LEGISLAGD_ENABLE_ECIDADE=1
# Compatibilidade com scripts antigos. Prefira LEGISLAGD_ENABLE_ECIDADE.
LEGISLAGD_INCLUDE_ECIDADE=1

# URLs dos forks/origens usados para clonar repositorios ausentes.
PORTALMODELO_SD_GIT_URL=https://github.com/sertaodigitalorg/PortalModelo-SD.git
SAPL_SD_GIT_URL=https://github.com/sertaodigitalorg/SAPL-SD.git
SIGI_SD_GIT_URL=https://github.com/sertaodigitalorg/SIGI-SD.git
PLENARIO_DIGITAL_CORE_GIT_URL=https://github.com/sertaodigitalorg/Plenario-Digital-Core.git
CHATWOOT_SD_GIT_URL=https://github.com/sertaodigitalorg/Chatwoot-SD.git
ECIDADE_SD_GIT_URL=https://github.com/sertaodigitalorg/e-Cidade-SD.git

# Branches opcionais por modulo. Se vazias, usam LEGISLAGD_COMPONENT_BRANCH.
# SAPL_SD_BRANCH=dev
# PORTALMODELO_SD_BRANCH=dev
# SIGI_SD_BRANCH=dev
# PLENARIO_DIGITAL_CORE_BRANCH=main
CHATWOOT_SD_BRANCH=dev
ECIDADE_SD_BRANCH=main

SAPL_SD_HOST=sapl.legislagd.localhost
PORTALMODELO_SD_HOST=portal.legislagd.localhost
ECIDADE_SD_HOST=ecidade.legislagd.localhost
SIGI_SD_HOST=sigi.legislagd.localhost
PLENARIO_HOST=plenario.legislagd.localhost
KEYCLOAK_HOST=id.legislagd.localhost

SAPL_SD_URL=http://sapl.legislagd.localhost
PORTALMODELO_SD_URL=http://portal.legislagd.localhost
ECIDADE_SD_URL=http://ecidade.legislagd.localhost
SIGI_SD_URL=http://sigi.legislagd.localhost
PLENARIO_URL=http://plenario.legislagd.localhost
KEYCLOAK_FRONTEND_URL=http://id.legislagd.localhost

# URLs entregues ao SAPL-SD quando ele roda integrado pelo LegislaGD.
LEGISLAGD_SIGI_SD_ENABLED=true
LEGISLAGD_SIGI_SD_URL=http://sigi.legislagd.localhost/pt_BR/admin/atendimentos
LEGISLAGD_SIGI_SD_CHAT_URL=http://chat.sigi.legislagd.localhost
LEGISLAGD_ECIDADE_ENABLED=true
LEGISLAGD_ECIDADE_URL=http://ecidade.legislagd.localhost
LEGISLAGD_ECIDADE_RH_URL=http://ecidade.legislagd.localhost/rh
LEGISLAGD_ECIDADE_FOLHA_URL=http://ecidade.legislagd.localhost/folha
LEGISLAGD_ECIDADE_FINANCEIRO_URL=http://ecidade.legislagd.localhost/financeiro
LEGISLAGD_ECIDADE_COMPRAS_URL=http://ecidade.legislagd.localhost/compras
LEGISLAGD_ECIDADE_CONTRATOS_URL=http://ecidade.legislagd.localhost/contratos
LEGISLAGD_ECIDADE_PATRIMONIO_URL=http://ecidade.legislagd.localhost/patrimonio
LEGISLAGD_PORTAL_ENABLED=true
LEGISLAGD_PORTAL_URL=http://portal.legislagd.localhost
LEGISLAGD_PLENARIO_DIGITAL_ENABLED=true
LEGISLAGD_PLENARIO_DIGITAL_URL=http://plenario.legislagd.localhost

# Acesso administrativo local do SAPL-SD.
SAPL_ADMIN_PASSWORD=interlegis
SAPL_ADMIN_EMAIL=admin@legislagd.localhost

# Postgres central do LegislaGD. A plataforma integrada usa uma unica
# instalacao PostgreSQL, com bases e usuarios separados por modulo.
LEGISLAGD_POSTGRES_PORT=5432
LEGISLAGD_POSTGRES_DB=legislagd
LEGISLAGD_POSTGRES_USER=legislagd
LEGISLAGD_POSTGRES_PASSWORD=legislagd_dev_password

SAPL_DB_NAME=sapl_sd
SAPL_DB_USER=sapl
SAPL_DB_PASSWORD=sapl_dev_password

PLENARIO_DB_NAME=plenario_core
PLENARIO_DB_USER=plenario
PLENARIO_DB_PASSWORD=plenario_dev_password
PLENARIO_DEBUG=true
PLENARIO_AUTH_REQUIRED=false
PLENARIO_ADMIN_ROLE=plenario.admin
PLENARIO_OPERATOR_ROLE=plenario.operador
PLENARIO_PARLIAMENTARY_ROLE=plenario.parlamentar
PLENARIO_PORT=8008
PLENARIO_ALLOWED_HOSTS=localhost,127.0.0.1,plenario.legislagd.localhost
PLENARIO_CSRF_TRUSTED_ORIGINS=http://plenario.legislagd.localhost
SAPL_BASE_URL=http://sapl.legislagd.localhost
SAPL_INTERNAL_BASE_URL=http://sapl-dev:8000
SAPL_API_TOKEN=
SAPL_TIMEOUT_SECONDS=5

SIGI_DB_NAME=sigi_sd
SIGI_DB_USER=sigi
SIGI_DB_PASSWORD=sigi_dev_password

CHATWOOT_DB_NAME=chatwoot_production
CHATWOOT_DB_USER=chatwoot
CHATWOOT_DB_PASSWORD=chatwoot_dev_password
CHATWOOT_SD_IMAGE=legislagd/chatwoot-sd:dev
CHATWOOT_FRONTEND_URL=http://chat.sigi.legislagd.localhost
CHATWOOT_DEFAULT_LOCALE=pt_BR

CHATWOOT_OIDC_ENABLED=true
CHATWOOT_OIDC_PROVIDER_NAME=legislagd
CHATWOOT_OIDC_DISPLAY_NAME=LegislaGD
CHATWOOT_OIDC_ISSUER=http://id.legislagd.localhost/realms/legislagd
CHATWOOT_OIDC_CLIENT_ID=chatwoot
CHATWOOT_OIDC_CLIENT_SECRET=
# CHATWOOT_OIDC_SCOPES is intentionally omitted by default because Docker Compose
# already provides "openid email profile" in the service override. Values with
# escaped spaces leak backslashes into the container.
CHATWOOT_OIDC_UI_LOCALES=pt-BR
# Opcional: habilita criacao JIT em uma conta Chatwoot especifica.
# Se vazio, o SSO vincula somente usuarios ja existentes por sub ou e-mail verificado.
CHATWOOT_OIDC_ACCOUNT_ID=1
CHATWOOT_SSO_PASSWORD=

ECIDADE_DB_NAME=ecidade
ECIDADE_DB_USER=dbseller
ECIDADE_DB_PASSWORD=dbseller
ECIDADE_PLUGIN_DB_USER=plugin
ECIDADE_PLUGIN_DB_PASSWORD=plugin
ECIDADE_LEGACY_DB_USER=dbseller
ECIDADE_LEGACY_DB_PASSWORD=dbseller

SIGI_OIDC_ENABLED=true
SIGI_OIDC_DISPLAY_NAME=LegislaGD
SIGI_OIDC_ISSUER=http://id.legislagd.localhost/realms/legislagd
SIGI_OIDC_CLIENT_ID=sigi
# SIGI_OIDC_SCOPES is intentionally omitted by default because Docker Compose
# already provides "openid email profile" in the service override. Values with
# escaped spaces leak backslashes into the container.

KEYCLOAK_REALM=legislagd
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password

SAPL_OIDC_ENABLED=true
SAPL_OIDC_PROVIDER_NAME=legislagd
SAPL_OIDC_DISPLAY_NAME=LegislaGD
SAPL_OIDC_ISSUER=http://id.legislagd.localhost/realms/legislagd
SAPL_OIDC_CLIENT_ID=sapl
SAPL_OIDC_CLIENT_SECRET=
# SAPL_OIDC_SCOPES is intentionally omitted by default because Docker Compose
# already provides "openid email profile" in the service override. Values with
# escaped spaces leak backslashes into the container.
SAPL_OIDC_UI_LOCALES=pt-BR
SAPL_OIDC_ALLOW_EMAIL_MATCH=true
SAPL_OIDC_CREATE_USER=true

INTEGRATION_AUTH_MODE=development
